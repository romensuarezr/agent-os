# ==============================================================================
# Nango — Configuración de Entorno (Plantilla Ejemplo)
# Servicio: Plataforma soberana de integración OAuth y APIs unificadas
# Frontera portable: Mantener placeholders genéricos sin IPs privadas ni secretos
# ==============================================================================

# IP de enlace en el host (127.0.0.1 para acceso local/proxy o IP privada de Tailscale)
HOST_BIND_IP=127.0.0.1

# Puertos oficiales de servicio
NANGO_SERVER_PORT=3003
NANGO_CONNECT_UI_PORT=3009

# Clave maestra de cifrado de credenciales OAuth (debe ser una clave aleatoria de 32 bytes codificada en base64)
# Generar en host con: openssl rand -base64 32
NANGO_ENCRYPTION_KEY=

# Configuración de base de datos PostgreSQL
NANGO_DB_USER=nango
NANGO_DB_PASSWORD=
NANGO_DB_NAME=nango

# URLs canónicas del servicio
NANGO_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_SERVER_URL=http://localhost:3003

# Nivel de log (info, warn, error, debug)
NANGO_LOG_LEVEL=info

# Límites de recursos de contenedores (Compose v2)
NANGO_SERVER_CPU_LIMIT=1.5
NANGO_SERVER_MEMORY_LIMIT=1024M
NANGO_SERVER_CPU_RESERVATION=0.2
NANGO_SERVER_MEMORY_RESERVATION=256M

NANGO_DB_CPU_LIMIT=1.0
NANGO_DB_MEMORY_LIMIT=512M
NANGO_DB_CPU_RESERVATION=0.1
NANGO_DB_MEMORY_RESERVATION=128M

NANGO_REDIS_CPU_LIMIT=0.5
NANGO_REDIS_MEMORY_LIMIT=256M
NANGO_REDIS_CPU_RESERVATION=0.05
NANGO_REDIS_MEMORY_RESERVATION=64M
