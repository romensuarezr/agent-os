# Configuración de despliegue soberano para SearXNG (Agent OS)
# Puerto externo de enlace
SEARXNG_PORT=8080

# URL pública o interna de acceso a la instancia
SEARXNG_BASE_URL=http://localhost:8080

# Clave secreta para cifrado de sesiones de SearXNG (generar con: openssl rand -hex 32)
SEARXNG_SECRET=change_me_to_a_random_secret_string

# Nombre de la instancia
INSTANCE_NAME=agent-os-search

# Límites de recursos (especificación de producción)
SEARXNG_CPU_LIMIT=1.0
SEARXNG_MEMORY_LIMIT=512M
SEARXNG_MEMORY_RESERVE=128M

REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=256M
REDIS_MEMORY_RESERVE=64M
