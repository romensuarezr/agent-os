# ==============================================================================
# Bane — Configuración de Entorno (Plantilla Ejemplo)
# Servicio: Motor soberano de deep research & búsqueda con razonamiento
# Frontera portable: Mantener placeholders genéricos sin IPs privadas ni secretos
# ==============================================================================

# Dirección IP de host y puerto de enlace
HOST_BIND_IP=127.0.0.1
BANE_PORT=3000

# Endpoint de inferencia OpenAI-compatible (FreeLLMAPI, Ollama, etc.)
BANE_INFERENCE_URL=http://<nodo-inferencia>:3001/v1
BANE_API_KEY=

# Endpoint del motor de búsqueda (SearXNG o similar)
BANE_SEARCH_URL=http://<nodo-inferencia>:8080

# Límites de recursos de contenedor (Compose v2)
# Nota: Configurados estrictamente dentro del spec original (<250MB)
BANE_CPU_LIMIT=1.0
BANE_MEMORY_LIMIT=250M
BANE_CPU_RESERVATION=0.1
BANE_MEMORY_RESERVATION=64M
