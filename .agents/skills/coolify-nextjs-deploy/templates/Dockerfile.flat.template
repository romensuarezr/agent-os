# syntax=docker/dockerfile:1
# ==============================================================================
# Dockerfile.flat.template — Multi-stage standalone para Next.js plano (Flat)
# Diseñado para Coolify VPS / Docker Engine (Node.js 22 LTS Alpine)
# ==============================================================================

# Stage 1: Imagen base
FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Stage 2: Instalación de dependencias (deps)
FROM base AS deps
WORKDIR /app

# Copia de manifiestos y lockfiles para caché óptima
COPY package.json package-lock.json* pnpm-lock.yaml* yarn.lock* ./

# Instalación condicional según lockfile presente
RUN \
  if [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm install --frozen-lockfile; \
  elif [ -f yarn.lock ]; then yarn install --frozen-lockfile; \
  elif [ -f package-lock.json ]; then npm ci; \
  else npm install; \
  fi

# Stage 3: Compilación (builder)
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1

# ==============================================================================
# Variables de entorno públicas requeridas en BUILD TIME (NEXT_PUBLIC_*)
# Declara aquí los ARG y expórtalos como ENV para que Next.js los embeba en el bundle.
# En Coolify, configúralos en: Application -> Environment Variables -> Build Variable (Build Args)
# ==============================================================================
# ARG NEXT_PUBLIC_API_URL
# ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN \
  if [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm run build; \
  elif [ -f yarn.lock ]; then yarn build; \
  else npm run build; \
  fi

# Stage 4: Ejecución en producción (runner)
FROM node:22-alpine AS runner
WORKDIR /app

RUN apk add --no-cache libc6-compat

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Seguridad: ejecutar bajo usuario no root
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copia de assets públicos y build standalone generado
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
